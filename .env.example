PORT=3000
DEBUG=false
#HTTPS_PROXY=http://localhost:7890

# Required by the default Compose deployment with bundled PostgreSQL.
#POSTGRES_PASSWORD=
# With docker-compose.external.yml, set SQL_DSN for an existing database.
# Leave SQL_DSN empty in that file for SQLite. Redis is optional.
#SQL_DSN=
#REDIS_CONN_STRING=
# Set a persistent random value for a public deployment.
#SESSION_SECRET=

# 首次启动引导：
# - 不设置该变量：首次打开控制台会进入 /setup 向导，由你选择 root 账户的用户名和密码。
# - 设置该变量：跳过向导，直接用该密码创建 root 账户（无头部署、Docker 等不打开浏览器的场景必须设置）。
#INITIAL_ROOT_PASSWORD=

# Optional Volcengine Ark pricing. Values are site quota per image or
# per requested video second, before the user's group multiplier.
#ARK_MEDIA_PRICES='{"doubao-seedream-5-5-261028":10000,"doubao-seedance-2-5-260628":25000}'

# Optional online top-ups. Define USD in cents and CNY in fen.
#PAYMENT_PUBLIC_URL=https://your-domain.example
#PAYMENT_PACKAGES='[{"id":"standard","name":"Standard","amount":1500,"cny_amount":9900,"quota":7500000}]'
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#NOWPAYMENTS_API_KEY=
#NOWPAYMENTS_IPN_SECRET=
# Comma-separated enabled payment currencies. Empty disables new NOWPayments orders.
#NOWPAYMENTS_PAY_CURRENCIES=usdtsol,usdcmatic,btc
# EPay: v1 (default), v2, or off.
#EPAY_VERSION=v1
# EPay V1 gateway base URL, without /submit.php.
#EPAY_GATEWAY_URL=https://payments.example
#EPAY_MERCHANT_ID=
#EPAY_MERCHANT_KEY=
# Leave empty for hosted cashier choice, or specify a gateway channel code.
#EPAY_PAYMENT_TYPE=alipay
# EPay V2 gateway base URL, without /api/pay/submit.
#EPAY_V2_GATEWAY_URL=https://payments.example
#EPAY_V2_MERCHANT_ID=
# RSA keys as base64 DER or PEM. Keep the private key in your deployment secrets.
#EPAY_V2_MERCHANT_PRIVATE_KEY=
#EPAY_V2_PLATFORM_PUBLIC_KEY=
# Airwallex Payment Links. Use sandbox credentials for sandbox mode.
#AIRWALLEX_ENV=production
#AIRWALLEX_CLIENT_ID=
#AIRWALLEX_API_KEY=
#AIRWALLEX_WEBHOOK_SECRET=
# GMPay Edge merchant API. Enable receiving assets and networks in GMPay.
#GMPAY_GATEWAY_URL=https://crypto.example
#GMPAY_PID=
#GMPAY_API_SECRET=
